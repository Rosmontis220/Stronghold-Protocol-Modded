{
  "name": "stronghold-protocol-alliance",
  "version": "0.1.2",
  "private": true,
  "description": "明日方舟「卫戍协议：盟约」非官方同人联机网页复刻（1–4 人合作，Node.js 服务器 + 浏览器客户端）",
  "license": "GPL-3.0-or-later",
  "homepage": "https://github.com/sganggs/Stronghold-Protocol#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sganggs/Stronghold-Protocol.git"
  },
  "bugs": {
    "url": "https://github.com/sganggs/Stronghold-Protocol/issues"
  },
  "keywords": [
    "arknights",
    "auto-chess",
    "tower-defense",
    "co-op",
    "browser-game",
    "fan-game"
  ],
  "type": "module",
  "main": "desktop/main.cjs",
  "build": {
    "appId": "top.rosmontis.stronghold.protocol",
    "productName": "Stronghold Protocol Alliance",
    "asar": true,
    "files": [
      "desktop/**",
      "server/**",
      "shared/**",
      "public/**",
      "data/**",
      "package.json",
      "node_modules/**"
    ],
    "extraResources": [],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Stronghold-Protocol-${version}-${channel}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "vendor": "node tools/vendor.mjs",
    "build-data": "node tools/build-data.mjs",
    "assets": "node tools/vendor.mjs && node tools/fetch-assets.mjs",
    "postinstall": "node tools/vendor.mjs",
    "setup": "node tools/setup.mjs",
    "doctor": "node tools/doctor.mjs",
    "launch": "node scripts/launch.mjs",
    "desktop:dir": "electron-builder --dir",
    "desktop:win": "electron-builder --win nsis portable",
    "mobile:sync": "npx cap sync android",
    "mobile:open": "npx cap open android",
    "mobile:apk": "npx cap sync android && gradlew.bat assembleDebug"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "htm": "^3.1.1",
    "pixi-spine": "^4.0.6",
    "pixi.js": "^7.4.2",
    "preact": "^10.29.8",
    "three": "^0.186.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/cli": "^8.5.2",
    "@capacitor/core": "^8.5.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "puppeteer-core": "^25.12.0",
    "typescript": "^7.0.2"
  }
}
