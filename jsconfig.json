{
  // First typecheck slice (npm run typecheck). strict stays off until a folder is clean.
  // tsc does not load this file unless invoked with -p jsconfig.json.
  // Widen one path at a time: see types/README.md.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": [],
    "lib": ["ES2022"],
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "shared/**/*.js",
    "server/sim/rng.js",
    "server/sim/detmath.js",
    "server/sim/dir.js",
    "server/sim/constants.js",
    "types/**/*.js"
  ],
  "exclude": [
    "shared/protocol.js",
    "shared/bandBonds.js",
    // Upstream 0.2.2 files the TypeScript 7 compiler rejects (93 × TS2339: property access on a value inferred as
    // `object`). Upstream pins typescript ^5.9.2 and is clean there; this fork pins ^7.0.2 and is stricter, so these
    // four fail only here. They are excluded to keep the slice green — re-including them needs the 5.9 compiler or a
    // rewrite of the four files. Verified: a pristine upstream/master checkout reports the same 93 errors under 7.0.2.
    "shared/diy.js",
    "shared/loadoutRecord.js",
    "shared/standIn.js",
    "shared/highGround.js"
  ]
}
