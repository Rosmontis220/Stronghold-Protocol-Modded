<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="game_background">#0c0f0e</color>
    <color name="game_accent">#4ed8af</color>
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/game_background</item>
        <item name="colorPrimaryDark">@color/game_background</item>
        <item name="colorAccent">@color/game_accent</item>
        <item name="android:windowBackground">@color/game_background</item>
    </style>
    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@color/game_background</item>
        <item name="android:navigationBarColor">@color/game_background</item>
    </style>
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/game_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/icon_launcher</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:windowBackground">@drawable/splash</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:navigationBarColor">@color/game_background</item>
        <item name="android:statusBarColor">@color/game_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
